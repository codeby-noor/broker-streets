# Environment Configuration
NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/broker-streets?retryWrites=true&w=majority

# CORS (Comma-separated allowed origins for custom domain and Railway frontend app)
CORS_ORIGIN=https://broker-streets-web.up.railway.app,https://brokerstreets.com

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_character_hex_string
JWT_REFRESH_EXPIRES_IN=30d

# OTP Session Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=10

# SMS Provider Configuration (MSG91)
# Item 3: When NODE_ENV=production, ENABLE_REAL_SMS must be "true" to prevent fatal boot errors in env.js.
# For local development with mock OTPs, set NODE_ENV=development and ENABLE_REAL_SMS=false.
# SECURITY NOTICE: With ENABLE_REAL_SMS=false in development, OTPs are logged in server console and returned in dev response objects.
ENABLE_REAL_SMS=true
SMS_PROVIDER=msg91
SMS_API_KEY=your_msg91_auth_key
SMS_SENDER_ID=BRKRST
SMS_TEMPLATE_ID=your_msg91_template_id

# Storage Provider Configuration (Cloudinary for Railway deployment)
UPLOAD_PROVIDER=cloudinary
UPLOAD_MAX_IMAGE_SIZE_MB=5
UPLOAD_MAX_VIDEO_SIZE_MB=50
UPLOAD_MAX_DOCUMENT_SIZE_MB=10
UPLOAD_MAX_AUDIO_SIZE_MB=10
UPLOAD_MAX_PROFILE_IMAGE_SIZE_MB=2

# Cloudinary Credentials (Required when UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Super Admin Account (Used to seed the initial AdminUser account on first boot)
ADMIN_DEFAULT_MOBILE=9876543210
ADMIN_DEFAULT_NAME=Super Admin
